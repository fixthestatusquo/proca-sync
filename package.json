{
  "name": "@proca/sync",
  "version": "2.0.0",
  "description": "Proca-to-CRM syncer",
  "repository": "git@github.com:fixthestatusquo/proca-sync.git",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "bin/sync",
  "run": "bin/sync",
  "bin": "bin/sync",
  "scripts": {
    "build": "tsc",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/test.ts",
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check . && tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "petition",
    "proca",
    "campaigning",
    "CRM",
    "civicrm",
    "brevo",
    "mailchimp",
    "mailjet",
    "salesforce",
    "digital-engagement",
    "social-change",
    "nonprofit",
    "civic-tech",
    "activism",
    "email-campaign",
    "RabbitMQ",
    "AMQP"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@sentry/types": "^10.38.0",
    "@types/cli-color": "^2.0.6",
    "@types/jsforce": "^1.11.6",
    "@types/mailchimp__mailchimp_marketing": "^3.0.21",
    "@types/minimist": "^1.2.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@getbrevo/brevo": "^5.0.1",
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@proca/crypto": "^3.4.0",
    "@proca/queue": "^6.3.0",
    "@sentry/node": "^10.78.0",
    "@supabase/supabase-js": "^2.103.2",
    "@topcli/spinner": "^4.2.1",
    "civicrm": "^3.2.2",
    "cli-color": "^2.0.4",
    "i18n-iso-countries": "^7.14.0",
    "jsforce": "^3.12.0",
    "lodash": "^4.18.1",
    "minimist": "^1.2.8",
    "node-mailjet": "^6.0.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
